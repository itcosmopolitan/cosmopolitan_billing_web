# OS
.DS_Store

# Logs (root / tooling)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# npm workspaces — dependencies hoist to repo root
node_modules/

# Wrong package manager — this repo uses npm workspaces, not yarn / pnpm.
# Block stray lockfiles so a teammate running `yarn install` by mistake can't
# commit a second source of truth that silently drifts from package-lock.json.
yarn.lock
**/yarn.lock
pnpm-lock.yaml
**/pnpm-lock.yaml
# Per-workspace npm lockfiles are also wrong — npm workspaces produce a single
# root package-lock.json. If one of these appears, delete it.
frontend/package-lock.json
backend/package-lock.json

# Python virtualenv (often created at repo root by run scripts)
venv/
.venv/
env/

# Secrets at repo root (subpackages also ignore via their .gitignore)
.env
.env.*
!.env.example

# IDE (optional)
.idea/

# ─── Local-only / not committed to feature branches ──────────────────────────
# Agent + tooling configuration kept local. Push these in a separate dedicated
# commit/PR if/when the team agrees on them — don't sneak them into feature PRs.
.cursor/
.github/
AGENTS.md
CLAUDE.md
CONTRIBUTING.md
# Local engineering docs (worksheet, design notes). docs/ISSUES.md and
# docs/USERS_AND_ROLES.md were already tracked in HEAD — they remain tracked,
# but new files added under docs/ are ignored. If you want to push doc changes
# touch them with `git add -f` deliberately.
docs/
