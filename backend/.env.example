# Cosmopolitan Pro Configuration
# Copy this to .env and update values for your environment

# ─── Database ────────────────────────────────────────────────────
# Local dev (default):
DATABASE_URL=sqlite+aiosqlite:///./retailos.db
# Render / PostgreSQL (use asyncpg driver):
# DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST/DBNAME?ssl=require

# ─── API Configuration ────────────────────────────────────────────
API_VERSION=v1
API_PREFIX=/api/v1
APP_TITLE=Cosmopolitan Pro API
APP_DESCRIPTION=Multi-branch retail billing, POS, inventory, and reporting platform
APP_VERSION=2.4.0

# ─── CORS Configuration ──────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── JWT Configuration ───────────────────────────────────────────
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ─── Auth Enforcement (RBAC) ─────────────────────────────────────
# true  (default since Phase 2) = real JWT verification + per-route
#         permission checks enforced. Routes that opt in via require_perm
#         return 401 without a valid token and 403 without the right perm.
# false = current_user() falls back to the seeded super-admin (open demo
#         mode). Useful for screenshot demos; never use in production.
AUTH_ENFORCED=true

# ─── Demo Mode ───────────────────────────────────────────────────
DEMO_MODE=true
