# RetailOS Configuration
# Copy this to .env and update values for your environment

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./retailos.db

# ─── API Configuration ────────────────────────────────────────────
API_VERSION=v1
API_PREFIX=/api/v1
APP_TITLE=Cosmopolitan Pro API
APP_DESCRIPTION=Multi-branch retail billing, POS, inventory, and reporting platform
APP_VERSION=2.4.0

# ─── CORS Configuration ──────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── JWT Configuration ───────────────────────────────────────────
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ─── Demo Mode ───────────────────────────────────────────────────
DEMO_MODE=true
